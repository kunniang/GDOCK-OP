#
# 机型选择（主架构与竞斗云定义）
#
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
# 注意：当前源码只有 p2w_r619ac-64m / p2w_r619ac-128m 两个变体，
# 裸 p2w_r619ac 只是公共 define 模板，没有对应 Kconfig 符号，写了也会被 defconfig 丢弃
CONFIG_TARGET_ipq40xx_generic_DEVICE_p2w_r619ac-128m=y

#
# 纯有线路由模式：彻底禁用 WiFi 驱动与固件
#
# CONFIG_PACKAGE_kmod-ath is not set
# CONFIG_PACKAGE_kmod-ath10k is not set
# CONFIG_PACKAGE_ath10k-firmware-qca4019 is not set
# CONFIG_PACKAGE_ipq-wifi-p2w_r619ac is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-basic is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# 当前源码的默认无线包名是 wpad-basic-mbedtls，上面三个旧名字现在已经不生效，
# 不显式禁掉这一个的话 hostapd-common + wpad + mbedtls 仍会被装进固件（约 2~3MB 纯浪费）
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# 板级校准数据，没有 ath10k 驱动时毫无用处
# CONFIG_PACKAGE_ath10k-board-qca4019 is not set

#
# 拨号上网（PPPoE）
#
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-pppoe=y

#
# IPV6支持
#
CONFIG_IPV6=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-ip6tables-extra=y
CONFIG_PACKAGE_6in4=y

#
# WireGuard 服务端（外网回家）
#
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_qrencode=y

#
# 插件集成
#
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-ttyd=y
# 当前源码已无 luci-app-accesscontrol 这个包，defconfig 会静默丢弃，写在这里只是误导
# CONFIG_PACKAGE_luci-app-accesscontrol=y
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-zerotier=y

# 静态主机名 / DNS 映射管理插件
# 注意：luci-app-hosts / luci-i18n-hosts-zh-cn 同样不在当前源码与 feeds 内，
# 需要该功能请改用「网络 - DHCP/DNS - 静态地址分配」，或自行引入对应 feed 后再开启
# CONFIG_PACKAGE_luci-app-hosts=y
# CONFIG_PACKAGE_luci-i18n-hosts-zh-cn=y

#
# 主题与界面
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_LUCI_LANG_zh_Hans=y

#
# 基础命令及其他工具
#
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_lscpu=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_curl=y

#
# 显式关闭 SSR-Plus
# 上一次编译出的固件里出现了 luci-app-ssr-plus 198-r2 和 luci-i18n-ssr-plus-zh-cn，
# 但本文件从未要求过它（lean 的 feeds.conf.default 会引入 helloworld 源）。
# 它和 PassWall 功能完全重复，还会额外拖进 ssr-local/ssr-redir、ssr-check、
# lua-neturl、nping、dns2tcp、shellsync 等一堆包。下面两行强制它不再进入固件。
#
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn is not set

#
# PassWall 与核心（完整支持 Trojan 与 Hysteria 2）
#
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# 核心：Sing-Box（同时支持 Trojan 与 Hysteria 2 协议）
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y

# 独立 Hysteria 核心支持
CONFIG_PACKAGE_hysteria=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y

# 分流与防污染组件
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# 网络与透明代理驱动模块
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y

# 基础依赖库
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_unzip=y

#
# USB 存储与文件系统
# 之前只编了 USB 控制器（kmod-usb3/xhci/dwc3），没有 mass-storage 与任何文件系统模块，
# 插 U 盘不会被识别成分区设备，block-mount/mount-utils 装了也挂不上。
# 仓库自带的 diy/qntfs-driver 是预编译 .ko，与当前 6.18.60 内核 vermagic 不匹配，
# 不再使用，NTFS 改走内核自带 ntfs3 驱动。
#
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
