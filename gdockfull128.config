#
# PassWall 与代理核心（支持 Trojan 与 Hysteria 2）
#
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# 核心：Sing-Box（完整支持 Trojan、Hysteria 2、VLESS、Shadowsocks）
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y

# 独立核心与协议组件（增强 Hysteria 1/2 与 Trojan 专用适配）
CONFIG_PACKAGE_hysteria=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y
CONFIG_PACKAGE_trojan-plus=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_Plus=y

# 分流、规则与防污染组件
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# 网络与透明代理（TProxy / NAT）关键内核模块
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y

# 基础辅助运行库
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_unzip=y

# 精简无用体积（禁用不需要的客户端核心，为竞斗云 128M 留足闪存）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray is not set
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssserver is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir is not set
# CONFIG_PACKAGE_v2ray-plugin is not set
